<?xml version="1.0"?>
<package format="3">
  <name>frenet_optimal_trajectory_planner</name>
  <version>0.0.0</version>
  <description>
    Frenet Optimal Trajectory local planner that overlays an avoidance path
    on top of the reference trajectory, built on the erdos-project
    frenet_optimal_trajectory_planner C++ core (vendored under thirdparty/).
  </description>
  <maintainer email="yasumoto.ryo01@gmail.com">yasumoto-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>eigen</depend>
  <depend>rclpy</depend>
  <depend>autoware_auto_planning_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>v2x_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
