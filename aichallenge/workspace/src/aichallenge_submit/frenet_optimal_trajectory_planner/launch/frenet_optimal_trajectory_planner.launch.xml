<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="input_trajectory_topic" default="/planning/scenario_planning/trajectory"/>
  <arg name="input_v2x_topic" default="/v2x/vehicle_positions"/>
  <arg name="input_kinematics_topic" default="/localization/kinematic_state"/>
  <arg name="output_trajectory_avoidance_topic" default="/planning/scenario_planning/trajectory_avoidance"/>
  <!-- reference.launch.xml と同じ規約。citycircuit は data/、kashiwanoha は data/kashiwanoha/ -->
  <arg name="track_subdir" default=""/>
  <arg name="track_width_csv"
       default="$(find-pkg-share frenet_optimal_trajectory_planner)/data/$(var track_subdir)track_width.csv"/>

  <node pkg="frenet_optimal_trajectory_planner" exec="frenet_optimal_trajectory_node.py"
        name="frenet_optimal_trajectory_node" output="screen">
    <!-- 走行可能領域チェック。FOT本体は境界を知らないので、生成後にコース外の
         経路を棄却する。false にすると壁に突っ込むので実車では変更しないこと -->
    <param name="enable_drivable_area_check" value="true"/>
    <!-- 参照ライン各点の左右余裕。scripts/generate_track_width.py で生成し、
         起動時に実際の参照ラインと照合する（不一致なら回避を停止） -->
    <param name="track_width_csv" value="$(var track_width_csv)"/>
    <!-- 車両幅 1.30m の半分 -->
    <param name="vehicle_half_width" value="0.65"/>
    <!-- 車線境界と実際の壁の差＋斜め姿勢時の車体の張り出し分 -->
    <param name="drivable_area_margin" value="0.2"/>
    <param name="track_width_match_tolerance" value="0.5"/>

    <!-- 早めに検知して滑らかに寄せるため（直前だと急ハンドルになる） -->
    <param name="avoid_distance_threshold" value="15.0"/>
    <!-- 相手車の半幅 0.65m ＋ 余裕。自車幅を二重に足さない -->
    <param name="obstacle_clearance" value="0.6"/>
    <!-- maxt * (max_speed + d_t_s * n_s_sample) より大きくする。足りないと
         スプラインが外挿になり経路が壊れる（ノード側でも下限を補正） -->
    <param name="waypoint_lookahead_distance" value="32.0"/>
    <param name="waypoint_lookbehind_points" value="5"/>
    <!-- 経路の始点が自車からこれ以上離れていたら棄却。
         局所スプライン／Frenet投影の失敗に対する安全網 -->
    <param name="max_start_position_error" value="2.0"/>

    <param name="max_speed" value="15.0"/>
    <param name="max_accel" value="5.0"/>
    <!-- tan(最大舵角 0.64 rad) / ホイールベース 1.087m -->
    <param name="max_curvature" value="0.7"/>
    <!-- 横方向のサンプリング範囲。上の走行可能領域チェックが最終防衛線に
         なったので、安全パラメータではなく探索範囲として調整してよい -->
    <param name="max_road_width_l" value="1.5"/>
    <param name="max_road_width_r" value="1.5"/>
    <param name="d_road_w" value="0.5"/>
    <param name="dt" value="0.1"/>
    <!-- 1回の回避動作が届く上限（maxt × 速度）。長くすると無関係な先の
         コーナーまで回り込む経路が選ばれる -->
    <param name="maxt" value="1.0"/>
    <param name="mint" value="0.5"/>
    <param name="d_t_s" value="1.0"/>
    <param name="n_s_sample" value="1.0"/>
    <param name="kd" value="1.0"/>
    <!-- 横速度のコスト。低くして寄せ始めが遅れないようにする -->
    <param name="kv" value="0.1"/>
    <param name="ka" value="0.1"/>
    <param name="kj" value="0.1"/>
    <param name="kt" value="0.1"/>
    <param name="ko" value="0.5"/>
    <param name="klat" value="1.0"/>
    <param name="klon" value="1.0"/>
    <param name="num_threads" value="0"/>

    <remap from="input/trajectory" to="$(var input_trajectory_topic)"/>
    <remap from="input/v2x_vehicle_positions" to="$(var input_v2x_topic)"/>
    <remap from="input/kinematics" to="$(var input_kinematics_topic)"/>
    <remap from="output/trajectory_avoidance" to="$(var output_trajectory_avoidance_topic)"/>
  </node>
</launch>
